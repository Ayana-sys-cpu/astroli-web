# ── Prisma / PostgreSQL (Supabase) ────────────────────────────────────────────
# Connection pooler URL (used by Prisma at runtime — port 6543)
DATABASE_URL="postgresql://postgres.YOUR_SUPABASE_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (used by Prisma for migrations — port 5432)
DIRECT_URL="postgresql://postgres.YOUR_SUPABASE_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# ── Google OAuth ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ── App ────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3001"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Founder Gmail address — the only account that can access /admin
ADMIN_EMAIL="your-founder-email@gmail.com"

# ── Family Track ──────────────────────────────────────────────────────────────
# Default monthly bot conversation limit per approved parent (can be overridden per parent in DB)
BOT_CAP_DEFAULT=50
