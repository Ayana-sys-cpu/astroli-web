generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  googleId                    String?                      @unique @map("google_id")
  email                       String                       @unique(map: "users_email_unique")
  name                        String?
  role                        Role
  gcCourses                   String?                      @map("gc_courses")
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @default(now()) @updatedAt @map("updated_at")
  first_name                  String?
  full_name                   String?
  alien_name                  String?
  base_avatar_url             String?
  avatar_url                  String?
  area_of_interest            String?
  last_avatar_personalised_at DateTime?                    @db.Timestamptz(6)
  auth_user_id                String?                      @db.Uuid
  generationJobs              GenerationJob[]
  journeys                    Journey[]
  mission_started_by_student  mission_started_by_student[]
  missionsCreated             Mission[]
  planetsCreated              Planet[]
  student_journeys            student_journeys[]
  planetSummaries             PlanetSummary[]

  @@map("users")
}

model Journey {
  id                  String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  googleCourseId      String?              @unique @map("google_course_id")
  title               String
  teacherId           String?              @map("teacher_id")
  curriculumJourneyId String?              @map("curriculum_journey_id")
  voteEndsAt          DateTime?            @map("vote_ends_at")
  lastMaterialSyncAt  DateTime?            @map("last_material_sync_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  curriculumMaterials CurriculumMaterial[]
  generationJobs      GenerationJob[]
  teacher             User?                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  curriculumJourney   Journey?             @relation("CurriculumTemplate", fields: [curriculumJourneyId], references: [id], onDelete: SetNull)
  classJourneys       Journey[]            @relation("CurriculumTemplate")
  missions            Mission[]
  student_journeys    student_journeys[]
  vote_sessions       vote_sessions[]
  classSessions       ClassSession[]

  @@index([teacherId])
  @@map("journeys")
}

model Mission {
  id                         String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  journeyId                  String                       @map("journey_id")
  question                   String
  questionDescription        String                       @map("question_description")
  projectTitle               String?                      @map("project_title")
  projectDescription         String?                      @map("project_description")
  state                      MissionState                 @default(locked)
  source                     ContentSource                @default(HARDCODED)
  openingMessage             String?                      @map("opening_message")
  openingQuickReplies        Json?                        @map("opening_quick_replies")
  startDate                  DateTime?                    @map("start_date") @db.Date
  endDate                    DateTime?                    @map("end_date") @db.Date
  mission_order              Int                          @map("order")
  generationJobId            String?                      @map("generation_job_id")
  createdBy                  String                       @map("created_by")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @default(now()) @updatedAt @map("updated_at")
  chapter                    String?
  mission_brief              String?
  opening_message_2          String?
  world_brief_summary        String?
  world_brief_items          Json?
  qa_answers                 Json?
  mission_qa_answers         Json?
  mission_started_by_student mission_started_by_student[]
  creator                    User                         @relation(fields: [createdBy], references: [id])
  generationJob              GenerationJob?               @relation(fields: [generationJobId], references: [id])
  journey                    Journey                      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  planets                    Planet[]

  @@index([journeyId])
  @@map("missions")
}

model Planet {
  id                   String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  missionId            String          @map("mission_id")
  title                String
  label                String?
  shortTitle           String?         @map("short_title")
  planetQuestion       String?         @map("planet_question")
  content              String
  source               ContentSource   @default(HARDCODED)
  openingMessage       String?         @map("opening_message")
  openingQuickReplies  Json?           @map("opening_quick_replies")
  mediaUrl             String?         @map("media_url")
  mediaType            MaterialType?   @map("media_type")
  generationJobId      String?         @map("generation_job_id")
  createdBy            String          @map("created_by")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at")
  icon                 String?
  hint                 String?
  characterFigure      String?         @map("character_figure")
  characterYear        String?         @map("character_year")
  characterLocation    String?         @map("character_location")
  studentRevealMessage String?         @map("student_reveal_message")
  sourceMaterials      PlanetSource[]
  planetSummaries      PlanetSummary[]
  creator              User            @relation(fields: [createdBy], references: [id])
  generationJob        GenerationJob?  @relation(fields: [generationJobId], references: [id])
  mission              Mission         @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId])
  @@map("planets")
}

model CurriculumMaterial {
  id               String         @id @default(uuid())
  journeyId        String         @map("journey_id")
  googleMaterialId String         @map("google_material_id")
  type             MaterialType   @default(OTHER)
  title            String
  description      String?
  url              String?
  extractedContent String?        @map("extracted_content")
  syncedAt         DateTime       @map("synced_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  journey          Journey        @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  planetSources    PlanetSource[]

  @@unique([journeyId, googleMaterialId])
  @@index([journeyId])
  @@map("curriculum_materials")
}

model PlanetSource {
  planetId   String             @map("planet_id")
  materialId String             @map("material_id")
  material   CurriculumMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  planet     Planet             @relation(fields: [planetId], references: [id], onDelete: Cascade)

  @@id([planetId, materialId])
  @@map("planet_sources")
}

model GenerationJob {
  id              String    @id @default(uuid())
  journeyId       String    @map("journey_id")
  triggeredBy     String    @map("triggered_by")
  status          JobStatus @default(PENDING)
  model           String?
  errorMessage    String?   @map("error_message")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  journey         Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  triggeredByUser User      @relation(fields: [triggeredBy], references: [id])
  missions        Mission[]
  planets         Planet[]

  @@index([journeyId])
  @@map("generation_jobs")
}

model Vote {
  id              String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId       String         @map("student_id")
  journeyId       String         @map("journey_id")
  bigIdeaId       String         @map("big_idea_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")
  vote_session_id String?
  vote_sessions   vote_sessions? @relation(fields: [vote_session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([studentId, journeyId])
  @@unique([studentId, vote_session_id], map: "votes_student_session_unique")
  @@index([journeyId])
  @@map("votes")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model app_context {
  student_id     String    @id @db.Uuid
  screen         String?   @default("mission_hub")
  mission        String?
  project        String?
  viewed_content String[]  @default([])
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  students       students  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model authorized_teachers {
  email String @id
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model messages {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id     String?   @db.Uuid
  role           String
  content        String
  screen_context String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  speaker        String?
  students       students? @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mission_started_by_student {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  student_id String
  mission_id String
  status     String    @default("started")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  missions   Mission   @relation(fields: [mission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, mission_id], map: "mission_started_unique")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model planet_characters {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planet_id           String   @unique(map: "one_character_per_planet")
  name                String
  mode                String
  bio                 String
  era                 String
  location            String
  voice_profile       String
  teaching_goal       String
  knowledge_cutoff    String
  sources             String?
  portrait_url        String?
  listening_video_url String?
  thinking_video_url  String?
  is_approved         Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model student_journeys {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  student_id  String
  journey_id  String
  enrolled_at DateTime? @default(now()) @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  journeys    Journey   @relation(fields: [journey_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       User      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, journey_id], map: "student_journeys_student_journey_unique")
  @@index([journey_id])
  @@index([student_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model students {
  id              String       @id @db.Uuid
  alien_name      String
  bot_base_avatar String?
  grade_level     Int?
  interests       String[]
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  app_context     app_context?
  messages        messages[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vote_sessions {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  journey_id String
  starts_at  DateTime? @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  winner_id  String?
  status     String    @default("open")
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  journeys   Journey   @relation(fields: [journey_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  votes      Vote[]

  @@index([journey_id])
  @@index([status])
}

model ClassSession {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  journeyId String   @map("journey_id")
  teacherId String   @map("teacher_id")
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([teacherId])
  @@map("class_sessions")
}

model PlanetSummary {
  id              String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId       String              @map("student_id")
  planetId        String              @map("planet_id")
  status          PlanetSummaryStatus @default(not_started)
  performanceType String?             @map("performance_type")
  assessedAt      DateTime?           @map("assessed_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  goals           PlanetSummaryGoal[]
  planet          Planet              @relation(fields: [planetId], references: [id], onDelete: Cascade)
  student         User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, planetId])
  @@index([studentId])
  @@index([planetId])
  @@map("planet_summaries")
}

model PlanetSummaryGoal {
  id              String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  summaryId       String        @map("summary_id")
  goalTitle       String        @map("goal_title")
  performanceType String?       @map("performance_type")
  botQuestion     String        @map("bot_question")
  studentAnswer   String        @map("student_answer")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  summary         PlanetSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  @@index([summaryId])
  @@map("planet_summary_goals")
}

model TeacherSignalAcknowledgement {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  teacherId  String   @map("teacher_id")
  studentId  String   @map("student_id")
  journeyId  String   @map("journey_id")
  signalType String   @map("signal_type")
  status     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([teacherId, studentId, journeyId, signalType], name: "unique_signal_ack")
  @@index([teacherId, journeyId])
  @@index([teacherId, studentId, signalType])
  @@map("teacher_signal_acknowledgements")
}

enum Role {
  teacher
  student
}

enum MissionState {
  locked
  voting
  pending_start
  active
  completed
  skipped
}

enum ContentSource {
  HARDCODED
  AI_GENERATED
  TEACHER_CREATED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MaterialType {
  ASSIGNMENT
  MATERIAL
  ANNOUNCEMENT
  DRIVE_FILE
  YOUTUBE
  LINK
  OTHER
}

enum PlanetSummaryStatus {
  not_started
  in_progress
  completed
}
